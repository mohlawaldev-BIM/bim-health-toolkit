<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BIM Health Toolkit"
    Width="600"
    Height="750"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#0F1117">

    <Window.Resources>
        <!-- Base text style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Score bar track -->
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Background"     Value="#1E2130"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Height"         Value="12"/>
        </Style>

        <!-- Card panel -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="#1A1D2E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding"      Value="20"/>
            <Setter Property="Margin"       Value="0,0,0,12"/>
        </Style>

        <!-- Recommendation item -->
        <Style x:Key="RecCard" TargetType="Border">
            <Setter Property="Background"   Value="#1E2130"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="12,8"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"  Value="#4F6CF7"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Height"      Value="42"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="20,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background"  Value="#2A2D3E"/>
            <Setter Property="Foreground"  Value="#A0A0B0"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Height"      Value="42"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="20,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main scroll container -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- ── HEADER ───────────────────────────────────────────── -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock
                    Text="BIM Health Toolkit"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"/>
                <TextBlock
                    x:Name="ModelNameText"
                    Text="Model: Loading..."
                    FontSize="12"
                    Foreground="#6B7280"
                    Margin="0,4,0,0"/>
                <TextBlock
                    x:Name="DateText"
                    Text=""
                    FontSize="11"
                    Foreground="#4B5563"
                    Margin="0,2,0,0"/>
            </StackPanel>

            <!-- ── OVERALL SCORE CARD ────────────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Text="Overall Health Score"
                            FontSize="13"
                            Foreground="#9CA3AF"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock
                                x:Name="OverallScoreText"
                                Text="--"
                                FontSize="52"
                                FontWeight="Bold"
                                Foreground="White"/>
                            <TextBlock
                                Text="/100"
                                FontSize="20"
                                Foreground="#6B7280"
                                VerticalAlignment="Bottom"
                                Margin="4,0,0,10"/>
                        </StackPanel>
                        <TextBlock
                            x:Name="StatusText"
                            Text="Calculating..."
                            FontSize="14"
                            Foreground="#9CA3AF"/>
                    </StackPanel>

                    <!-- Grade badge -->
                    <Border
                        Grid.Column="1"
                        x:Name="GradeBadge"
                        Background="#1E2130"
                        CornerRadius="16"
                        Width="72"
                        Height="72"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="GradeText"
                            Text="-"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── SCORE BREAKDOWN CARD ──────────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Text="Score Breakdown"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0,0,0,16"/>

                    <!-- Warnings row -->
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border
                                    Background="#EF444420"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,8,0">
                                    <TextBlock
                                        Text="⚠ Warnings"
                                        FontSize="12"
                                        Foreground="#EF4444"/>
                                </Border>
                                <TextBlock
                                    x:Name="WarningsWeightText"
                                    Text="35% weight"
                                    FontSize="11"
                                    Foreground="#6B7280"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="WarningsScoreText"
                                Text="--/100"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White"/>
                        </Grid>
                        <Border Style="{StaticResource BarTrack}">
                            <Border
                                x:Name="WarningsBar"
                                Background="#EF4444"
                                CornerRadius="6"
                                Height="12"
                                HorizontalAlignment="Left"
                                Width="0"/>
                        </Border>
                    </StackPanel>

                    <!-- Bloat row -->
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border
                                    Background="#F59E0B20"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,8,0">
                                    <TextBlock
                                        Text="🧱 File Bloat"
                                        FontSize="12"
                                        Foreground="#F59E0B"/>
                                </Border>
                                <TextBlock
                                    x:Name="BloatWeightText"
                                    Text="30% weight"
                                    FontSize="11"
                                    Foreground="#6B7280"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="BloatScoreText"
                                Text="--/100"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White"/>
                        </Grid>
                        <Border Style="{StaticResource BarTrack}">
                            <Border
                                x:Name="BloatBar"
                                Background="#F59E0B"
                                CornerRadius="6"
                                Height="12"
                                HorizontalAlignment="Left"
                                Width="0"/>
                        </Border>
                    </StackPanel>

                    <!-- Parameters row -->
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border
                                    Background="#10B98120"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,8,0">
                                    <TextBlock
                                        Text="🏷 Parameters"
                                        FontSize="12"
                                        Foreground="#10B981"/>
                                </Border>
                                <TextBlock
                                    x:Name="ParamWeightText"
                                    Text="35% weight"
                                    FontSize="11"
                                    Foreground="#6B7280"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="ParamScoreText"
                                Text="--/100"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White"/>
                        </Grid>
                        <Border Style="{StaticResource BarTrack}">
                            <Border
                                x:Name="ParamBar"
                                Background="#10B981"
                                CornerRadius="6"
                                Height="12"
                                HorizontalAlignment="Left"
                                Width="0"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ── RECOMMENDATIONS CARD ──────────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Text="Recommendations"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0,0,0,12"/>

                    <!-- Recommendations will be added here by Python -->
                    <StackPanel x:Name="RecommendationsPanel"/>
                </StackPanel>
            </Border>

            <!-- ── BUTTONS ───────────────────────────────────────────── -->
            <Grid Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    x:Name="OpenDashboardBtn"
                    Content="Open Web Dashboard"
                    Style="{StaticResource PrimaryBtn}"/>

                <Button
                    Grid.Column="2"
                    x:Name="CloseBtn"
                    Content="Close"
                    Style="{StaticResource CloseBtn}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>